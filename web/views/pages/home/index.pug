extends ../../layouts/default.pug

block head
  script(src="/vendor/chart.js/chart.umd.js")

block main
  div(class="p-4 md:p-6 lg:p-8 flex-1 w-full max-w-[1800px] mx-auto flex flex-col gap-5")

    header(class="flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4")
      div
        h2(class="text-2xl md:text-3xl font-semibold text-on-surface tracking-tight mb-2") Phân tích cây trực tiếp
        p(class="text-body-sm text-on-surface-variant flex items-center gap-2 flex-wrap")
          span#livePulseDot(class="w-2 h-2 rounded-full bg-on-surface-variant")
          span YOLO Tracking
          span(class="text-outline-variant") •
          span#streamStatusLabel VisionComputer — chờ khởi động stream
      div(class="flex gap-2 flex-wrap")

    //- Video (trái, lớn) + Biểu đồ (phải)
    div(class="grid grid-cols-1 xl:grid-cols-12 gap-4 xl:gap-5 items-stretch")
      section(class="xl:col-span-7 flex flex-col bg-surface border border-outline-variant rounded-xl overflow-hidden shadow-sm min-h-[420px] xl:min-h-[min(72vh,780px)]")
        div(class="flex items-center justify-between px-4 py-3 border-b border-outline-variant bg-surface-container-low shrink-0")
          div(class="flex items-center gap-2")
            span(class="material-symbols-outlined text-primary text-[20px] icon-fill") videocam
            span(class="font-medium text-on-surface") Luồng video realtime
          div#liveBadge(class="hidden items-center gap-1.5 px-2.5 py-1 bg-primary/15 rounded-full text-primary border border-primary/25")
            span(class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse")
            span(class="font-mono-data text-[11px] font-semibold tracking-wide") LIVE

        div(class="relative flex-1 w-full bg-surface-container-high overflow-hidden flex items-center justify-center min-h-[360px] xl:min-h-0")
          div(class="absolute inset-0 pointer-events-none opacity-[0.07] bg-[linear-gradient(rgba(78,222,163,0.15)_1px,transparent_1px),linear-gradient(90deg,rgba(78,222,163,0.15)_1px,transparent_1px)] bg-[size:32px_32px]")
          canvas#videoOverlay(class="relative z-10 w-full h-full max-h-[min(68vh,720px)] object-contain block")

        div(class="shrink-0 flex flex-col gap-3 p-4 bg-surface border-t border-outline-variant")
          div(class="flex flex-wrap items-center gap-3 text-body-sm text-on-surface-variant")
            span(class="material-symbols-outlined text-[18px] text-primary") camera
            span Camera / Video AI
            span(class="text-outline-variant mx-1") |
            span#importStatus Sẵn sàng
          div(class="flex flex-wrap items-center gap-2")
            label(class="flex items-center gap-2 text-[13px] text-on-surface-variant")
              | Tảo bắt đầu
              input#cvStartHour(type="number" min="0" max="23" value="23" class="w-14 rounded-lg border border-outline-variant bg-surface-container-low px-2 py-1.5 text-on-surface text-center focus:border-primary focus:ring-1 focus:ring-primary/40 outline-none")
            label(class="flex items-center gap-2 text-[13px] text-on-surface-variant")
              | Tảo kết thúc
              input#cvEndHour(type="number" min="0" max="23" value="11" class="w-14 rounded-lg border border-outline-variant bg-surface-container-low px-2 py-1.5 text-on-surface text-center focus:border-primary focus:ring-1 focus:ring-primary/40 outline-none")
            button#btnDemoMode(type="button" class="bg-surface-container-low text-on-surface border border-outline-variant px-3 py-2 rounded-lg text-sm font-medium hover:bg-surface-container-highest transition-all flex items-center gap-1.5")
              span(class="material-symbols-outlined text-[18px]") play_arrow
              | Demo
            button#btnLiveMode(type="button" class="bg-primary text-on-primary px-4 py-2 rounded-lg text-sm font-semibold hover:opacity-90 transition-opacity flex items-center gap-1.5 shadow-md shadow-primary/20")
              span(class="material-symbols-outlined text-[18px] icon-fill") videocam
              | Live
            button#btnStopAll(type="button" class="bg-error/20 text-error border border-error/50 px-3 py-2 rounded-lg text-sm font-semibold hover:bg-error/30 transition-all flex items-center gap-1.5")
              span(class="material-symbols-outlined text-[18px]") stop_circle
              | Dừng AI

      aside(class="xl:col-span-5 flex flex-col gap-4 min-h-[320px] xl:min-h-[min(72vh,780px)]")
        div(class="base-card p-4 md:p-5 flex flex-col flex-1 min-h-[280px] xl:min-h-0")
          div(class="flex justify-between items-center mb-3 shrink-0")
            h3(class="text-lg font-semibold text-on-surface") Biểu đồ sức khỏe cây
            span(class="text-[11px] text-on-surface-variant font-mono-data") Timeline
          div(class="flex-1 relative w-full min-h-[220px] xl:min-h-[200px]")
            canvas#plantAreaChart(class="w-full h-full" style="max-height: 100%;")

        //- Giọng nói (wit.ai — UI sẵn)
        div#voicePanel(class="base-card p-4 border border-tertiary/25 bg-surface-container-low/50 shrink-0")
          div(class="flex items-center justify-between gap-2 mb-3")
            div(class="flex items-center gap-2")
              span(class="material-symbols-outlined text-tertiary text-[22px]") mic
              h3(class="text-sm font-semibold text-on-surface") Điều khiển giọng nói
            span(class="text-[10px] uppercase tracking-wider text-on-surface-variant px-2 py-0.5 rounded bg-surface-container-high") wit.ai
          p(class="text-xs text-on-surface-variant mb-3") Chỉ giọng nói ghi đè bơm. Realtime vẫn tự bật/tắt theo độ ẩm đất. Bấm <strong class="text-primary font-medium">Tự động bơm</strong> để trả về logic đất.
          div(class="flex flex-wrap gap-2 mb-3")
            button.voice-chip(type="button" data-voice-cmd="tắt máy bơm" class="text-xs px-2.5 py-1 rounded-full border border-outline-variant text-on-surface-variant hover:border-primary hover:text-primary transition-colors") tắt máy bơm
            button.voice-chip(type="button" data-voice-cmd="bật máy bơm" class="text-xs px-2.5 py-1 rounded-full border border-outline-variant text-on-surface-variant hover:border-secondary hover:text-secondary transition-colors") bật máy bơm
            button#btnPumpAuto(type="button" class="text-xs px-2.5 py-1 rounded-full border border-tertiary/50 text-tertiary hover:bg-tertiary/10 transition-colors font-medium" title="DELETE /home/api/iot/pump-override — bơm theo đất") Tự động bơm
          div(class="flex gap-2 items-start")
            button#btnVoiceMic(type="button" class="shrink-0 w-11 h-11 rounded-full bg-primary/20 border border-primary/40 text-primary flex items-center justify-center hover:bg-primary/30 transition-colors" title="Nhấn để nói (Chrome · Web Speech API)")
              span(class="material-symbols-outlined text-[24px]") mic
            div(class="flex-1 min-w-0")
              input#voiceTextInput(type="text" placeholder="Nhập lệnh thử: tắt máy bơm..." class="w-full rounded-lg border border-outline-variant bg-surface px-3 py-2 text-sm text-on-surface placeholder:text-on-surface-variant focus:border-primary focus:ring-1 focus:ring-primary/30 outline-none")
              p#voiceStatus(class="text-[11px] text-on-surface-variant mt-1.5") Bấm mic (Chrome) hoặc nhập câu lệnh · server dùng Wit.ai nếu có token.
          p#voiceLastCommand(class="text-xs text-tertiary mt-2 hidden")

    //- Admin — tầng cao nhất (ghi đè giọng nói + logic đất)
    section#adminPumpPanel(class="base-card p-4 border-2 border-amber-500/50 bg-amber-500/5 shrink-0")
      div(class="flex flex-wrap items-center justify-between gap-2 mb-3")
        div(class="flex items-center gap-2")
          span(class="material-symbols-outlined text-amber-400 text-[22px]") admin_panel_settings
          h3(class="text-sm font-semibold text-on-surface") Điều khiển Admin — Máy bơm
        span(class="text-[10px] uppercase tracking-wider font-bold text-amber-400 px-2 py-0.5 rounded bg-amber-500/15 border border-amber-500/30") Quyền cao nhất
      p(class="text-xs text-on-surface-variant mb-3")
        | Bật/tắt trực tiếp rơ-le ESP32. Thắng giọng nói và chế độ tự động (25% → 60%).
        |  Bấm <strong class="text-amber-400 font-medium">Tự động</strong> để trả về logic đất.
      div(class="flex flex-wrap gap-2")
        button#btnPumpOn(type="button" class="text-sm font-semibold px-4 py-2 rounded-lg bg-secondary/20 border border-secondary/60 text-secondary hover:bg-secondary/30 transition-colors flex items-center gap-1.5")
          span(class="material-symbols-outlined text-[18px]") water_pump
          | Bật bơm
        button#btnPumpOff(type="button" class="text-sm font-semibold px-4 py-2 rounded-lg bg-surface-container-high border border-outline-variant text-on-surface hover:bg-surface-container-highest transition-colors flex items-center gap-1.5")
          span(class="material-symbols-outlined text-[18px]") water_drop
          | Tắt bơm
        button#btnPumpManualAuto(type="button" class="text-sm font-medium px-4 py-2 rounded-lg border border-amber-500/40 text-amber-400 hover:bg-amber-500/10 transition-colors") Tự động (25% → 60%)
      p#adminPumpStatus(class="text-[11px] text-on-surface-variant mt-2") Sẵn sàng · khóa mặc định: vision-admin

    //- Bento metrics
    section(class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-4")
      div(class="base-card p-4 flex flex-col justify-between min-h-[110px]")
        div(class="flex justify-between items-start mb-2")
          p(class="text-sm text-on-surface-variant") Độ ẩm đất
          span(class="material-symbols-outlined text-primary/80") water_drop
        span#heroSoilMoisture(class="text-3xl font-semibold text-on-surface")
          if lastSoilMoisture !== null && lastSoilMoisture !== undefined
            | #{lastSoilMoisture}%
          else
            | --%
        div#heroSoilBar(class="w-full bg-surface-container-high h-1.5 rounded-full overflow-hidden mt-2")
          div#heroSoilBarFill(class="bg-secondary h-full rounded-full transition-all duration-500" style=`width: ${lastSoilMoisture != null ? Math.min(100, Math.max(0, lastSoilMoisture)) : 0}%`)

      div(class="base-card p-4 flex flex-col justify-between min-h-[110px]")
        div(class="flex justify-between items-start mb-2")
          p(class="text-sm text-on-surface-variant") Sức khỏe AI
          span(class="material-symbols-outlined text-secondary/90") psychology
        span#heroAiStatus(class="text-2xl font-semibold text-secondary") #{latestStatus}
        p(class="text-xs text-on-surface-variant mt-1") Vision AI

      div(class="base-card p-4 flex flex-col justify-between min-h-[110px]")
        div(class="flex justify-between items-start mb-2")
          p(class="text-sm text-on-surface-variant") Nhiệt độ
          span(class="material-symbols-outlined text-orange-400/90") device_thermostat
        span#iotTempValue(class="text-3xl font-semibold text-on-surface") --
        p(class="text-xs text-on-surface-variant mt-1") °C · DHT11

      div(class="base-card p-4 flex flex-col justify-between min-h-[110px]")
        div(class="flex justify-between items-start mb-2")
          p(class="text-sm text-on-surface-variant") Độ pH
          span(class="material-symbols-outlined text-violet-400/90") science
        span#iotPhValue(class="text-3xl font-semibold text-on-surface") --
        p(class="text-xs text-on-surface-variant mt-1") 0–14

      div#pumpControlCard(class="bg-primary-container border border-primary/40 text-on-primary-container rounded-xl p-4 flex flex-col justify-between min-h-[110px] shadow-sm")
        div(class="flex justify-between items-start mb-2")
          p(class="text-sm opacity-90") Máy bơm
          span(class="material-symbols-outlined opacity-90") water_pump
        span#iotPumpValue(class="text-3xl font-semibold block leading-none") --
        p#iotPumpHint(class="text-xs opacity-80 mt-1") Chờ dữ liệu · tự động: bật &lt;25%, tắt ≥60%

    div(class="grid grid-cols-1 md:grid-cols-2 gap-4")
      div(class="base-card p-4 border-l-4 border-l-tertiary")
        h4(class="text-sm font-medium text-on-surface mb-1") Trạng thái chi tiết
        p#latestStatusLine(class="text-body-sm text-on-surface-variant leading-relaxed") (Chưa có cập nhật)
      div#iotMetricsGrid(class="base-card p-4 border-l-4 border-l-secondary")
        p(class="text-xs text-on-surface-variant mb-1") Đồng bộ ESP32
        p#iotMetricsCaption(class="text-body-sm text-on-surface-variant") Chưa có dữ liệu.
        span#iotSoilValue(class="hidden" aria-hidden="true") --

block script
  script.
    window.__PLANT_CHART_DATA__ = {
      labels: !{chartLabels || "[]"},
      areaData: !{chartArea || "[]"},
      healthData: !{chartHealth || "[]"},
      lastSoilMoisture: !{lastSoilMoisture === null || lastSoilMoisture === undefined ? "null" : lastSoilMoisture}
    };
    window.__VIDEO_IMPORT_CONFIG__ = {
      startEndpoint: "/home/api/stream/start",
      stopEndpoint: "/home/api/stream/stop",
      pumpCommandEndpoint: "/home/api/iot/pump",
      pumpManualEndpoint: "/home/api/iot/pump/manual",
      pumpAutoEndpoint: "/home/api/iot/pump-override",
      pumpAdminKey: !{JSON.stringify(pumpAdminKey || "vision-admin")},
      pumpDryThreshold: 25,
      pumpWetThreshold: 60,
      voiceCommandEndpoint: "/home/api/voice-command",
      liveEndpoint: "/home/api/sensors",
      trackingEndpoint: "/home/api/stream/overlay",
      ipCameraUrl: "http://192.168.1.3:4747/video",
      streamRunning: !{streamRunning ? "true" : "false"},
      lastSensorTimestampIso: !{lastSensorTimestampIso ? JSON.stringify(lastSensorTimestampIso) : "null"}
    };
  script(src="/javascript/script.js")
